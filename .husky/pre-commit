# Pre-render D2 diagrams to committed SVGs and stage them, so a `.d2` edit and
# its rendered `.svg` land in the same commit. Every scene renders every time
# (the render gates are cross-cutting) and the render is byte-deterministic, so
# an unchanged scene rewrites identical bytes and stages nothing. Keeps diagram
# rendering OUT of `next build` so Vercel's build image only sees committed SVGs.
pnpm prerender:diagrams && git add public/diagrams

# Secret scan (sec-secret-scan-blocks-build): block a commit that stages a
# detectable secret before it ever lands in history. Runs gitleaks over the
# STAGED diff; a non-zero exit aborts the commit. FAILS CLOSED - if gitleaks is
# not installed the commit aborts with an install instruction.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --staged --redact --no-banner
else
  echo "[pre-commit] gitleaks not installed - local secret scan cannot run. Install it: brew install gitleaks"
  exit 1
fi

pnpm lint

# Storybook-first gate: every component in the storied tiers (ui/, ds/,
# pages/, storybook-fixtures/) must have a sibling *.stories.tsx.
pnpm lint:stories
