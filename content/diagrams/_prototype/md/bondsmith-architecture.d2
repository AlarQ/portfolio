direction: down

cli: |md
  ## flowctl (CLI)
  thin clap shell: argv, ports, exit code
| { class: node }
web: |md
  ## bondsmith-web
  Dioxus desktop, read-only - in progress
| { class: node }

core: "bondsmith-core - all the substance, layer-first" {
  class: group

  infra: |md
    ## infrastructure
    git / gate runner / state store / clock
  | { class: node }
  app: |md
    ## application
    Driver + six IO ports
  | { class: node }
  domain: |md
    ## domain
    pure, zero IO - contracts, state, findings
  | { class: emphasis }

  infra -> app: "implements the ports" { class: edge }
  app -> domain: "evaluates against" { class: edge }
}

cli -> core { class: edge }
web -> core { class: edge }
