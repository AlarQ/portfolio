direction: down

work: "model works" { class: node }
log: "event log\nfindings captured per run" { class: node }
review: "I review\naccept / reject" { class: emphasis }
mine: "mine the findings" { class: node }
rules: "new rules" { class: terminal }

work -> log { class: edge }
log -> review { class: edge }
review -> mine { class: edge }
mine -> rules { class: edge }
rules -> work: "caught earlier next run" { class: edge-feedback }
